# Copy this file to .env and fill only the values needed locally.
# Never commit API keys, OAuth tokens, cookies, or payment information.
# Preferred Maps MCP credentials. OAuth takes precedence if both are set.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_OAUTH_ACCESS_TOKEN=
# Legacy alias retained for existing local setups.
GOOGLE_MAPS_GROUNDING_API_KEY=
TRAVEL_AGENT_DB=data/travel-agent.sqlite
TRAVEL_AGENT_CONFIG=config/travel-agent.yaml
TRAVEL_AGENT_DASHBOARD_PORT=4177

# Telegram Bot API push notifications. Keep the real values only in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
